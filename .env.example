# Supabase project — same project shared by ZeloPDV and ZeloChat.
# These are PUBLIC client values (anon key); no service-role secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Chave exclusiva para chamadas internas de descoberta de catálogo pelo ZeloChat.
# Nunca exponha no navegador, em logs ou em código cliente.
ZELO_INTERNAL_API_KEY=

# Web Push (generate one VAPID key pair per environment). Keep the private
# key server-only; only the public key is exposed to the browser. In Dokploy,
# configure these as runtime Environment Variables (not only Build Args).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@zelopdv.com.br

# Optional only when the frontend is hosted on a different origin.
# Comma-separated exact origins; keep empty for the default same-origin setup.
CORS_ORIGINS=

# Delivery providers (server only; configure hosted fallbacks for Tier S).
DELIVERY_PROVIDER_TIMEOUT_MS=2500
DELIVERY_TOTAL_DEADLINE_MS=6000
DELIVERY_CACHE_TTL_DAYS=30
DELIVERY_ROUTE_CACHE_TTL_DAYS=7
DELIVERY_STALE_MAX_DAYS=30
DELIVERY_STORE_DATA_TTL_MS=60000
VIACEP_BASE_URL=https://viacep.com.br
BRASILAPI_CEP_BASE_URL=https://brasilapi.com.br
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_PROVIDER=nominatim
GEOCODING_MIN_INTERVAL_MS=1000
# Local/dev fallback example. In production, use a contracted provider and
# credentials/rate limits appropriate for Tier S traffic.
GEOCODING_FALLBACK_PROVIDER=arcgis
GEOCODING_FALLBACK_BASE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer
GEOCODING_USER_AGENT=ZeloMenu/1.0 (contato@zelopdv.com.br)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_FALLBACK_BASE_URL=

# Map tiles used only by the admin coverage preview. Configure a contracted
# provider in production; attribution must match the provider's terms.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
